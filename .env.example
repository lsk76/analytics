# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Database (optional — SQLite used if POSTGRES_DB is empty)
# POSTGRES_DB=tg_events
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# TeleZip Search API
TELEZIP_API_KEY=
TELEZIP_BASE_URL=https://api.telezip.net/v3
# Max concurrent TeleZip requests (API limit). Use 1 to be safest.
TELEZIP_MAX_CONCURRENCY=2

# Telemetr.io Public API (https://api.tlmtr.io/rapidoc) — 2nd Telegram search source.
# Auth is header `x-api-key`. Quota is two-dimensional: requests AND unique
# search terms / unique channels — see backend/analysis/services/telemetrio.py.
TELEMETRIO_API_KEY=
TELEMETRIO_BASE_URL=https://api.tlmtr.io
# Local record of which search terms were already paid for (API reports the
# count, never the list). Mount/share it if host and container both run tests.
# TELEMETRIO_TERMS_FILE=

# OpenRouter (LLM for classification / dedup / canonicalization)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# Telegram (Telethon) — for the account manager / enrichment
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
