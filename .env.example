# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Database (optional — SQLite used if POSTGRES_DB is empty)
# POSTGRES_DB=tg_events
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# TeleZip Search API
TELEZIP_API_KEY=
TELEZIP_BASE_URL=https://api.telezip.net/v3

# OpenRouter (LLM for classification / dedup / canonicalization)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# Telegram (Telethon) — for the account manager / enrichment
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
