# ============================================================================
# .env для СЕРВЕРА АНАЛІТИКИ. Скопіюй у корінь як .env і заповни.
#   cp deploy/.env.prod.example .env && chmod 600 .env && nano .env
# ⚠️ .env містить секрети — права 600, у git НЕ комітити.
# ============================================================================

# --- Django ---
# Згенеруй: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=ЗАМІНИ_НА_ВЛАСНИЙ_ДОВГИЙ_СЕКРЕТ
DJANGO_DEBUG=false
# ЛИШЕ свій домен (без *). Через кому, якщо кілька.
DJANGO_ALLOWED_HOSTS=analytics.matter-d.pro
# Обов'язково для POST-форм адмінки за https (зі схемою!):
DJANGO_CSRF_TRUSTED_ORIGINS=https://analytics.matter-d.pro
# nginx термінує TLS → лишаємо true (дефолт):
DJANGO_SECURE_PROXY_SSL_HEADER=true

# --- Postgres (не публікується назовні; лише в compose-мережі) ---
POSTGRES_DB=tg_events
POSTGRES_USER=tg_events
# Згенеруй міцний: openssl rand -base64 32
POSTGRES_PASSWORD=ЗАМІНИ_НА_МІЦНИЙ_ПАРОЛЬ

# --- TeleZip Search API (збір) ---
TELEZIP_API_KEY=
TELEZIP_BASE_URL=https://api.telezip.net/v3
TELEZIP_MAX_CONCURRENCY=2

# --- OpenRouter (LLM класифікація/дедуп) ---
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash

# --- Telegram (Telethon: enrich) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- (опційно) публікація в канал, якщо запускатимеш publish і тут ---
# TELEGRAM_BOT_TOKEN=
